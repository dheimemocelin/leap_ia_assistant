APP_ENV=local
WEB_CHAT_PASSWORD=
APP_API_KEY=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql+psycopg://leap:leap@localhost:5432/leap
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=disabled
GROQ_API_KEY=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=15
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
SYONET_BASE_URL=
SYONET_API_KEY=
SYONET_CONTRACT_PATH=/contracts/syonet-opportunity.json

# Optional local private pilot. Empty keeps existing behavior.
PILOT_DB_PATH=

# WhatsApp pilot. Server credentials only; customers never receive these values.
EVOLUTION_ENABLED=false
EVOLUTION_SEND_ENABLED=false
EVOLUTION_URL=http://127.0.0.1:8081
EVOLUTION_INSTANCE=leap-pilot
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_IDENTITY_KEY=
EVOLUTION_ALLOWED_NUMBERS=

# Opt-in incoming voice. Replies are text-only; do not enable without pilot review.
EVOLUTION_AUDIO_ENABLED=false
AUDIO_MAX_BYTES=2000000
AUDIO_MAX_SECONDS=120
STT_PROVIDER=disabled
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=
STT_TIMEOUT_SECONDS=30
# Optional operator-maintained rate; empty means cost unknown.
# STT_USD_PER_AUDIO_HOUR=0.04
# Optional LLM tariffs; leave unset if unknown. Values are USD per million tokens.
# LLM_INPUT_USD_PER_MILLION=0.15
# LLM_OUTPUT_USD_PER_MILLION=0.60
